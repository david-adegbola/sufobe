{
  "name": "kasva",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "balance": "vite-node tools/balance.ts",
    "forest": "vite-node tools/forest-run.ts",
    "bundle:single": "node tools/single-file.mjs",
    "lint": "eslint . && cd .. && game/node_modules/.bin/eslint --config eslint.config.cjs js tests",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "rotation-check": "vite-node tools/rotation-check.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "axe-core": "^4.13.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "qrcode-generator": "^2.0.4"
  }
}
